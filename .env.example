# Dupliquer ce fichier en .env et renseigner les valeurs.
# ⚠️ Ne jamais committer le vrai .env (ignoré par git).

# Base PostgreSQL hébergée (ex. Neon — sslmode requis)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cockpit rédaction — mot de passe administrateur (≥ 8 caractères)
# Générer : openssl rand -base64 18
ADMIN_PASSWORD=changez-moi

# Clé de signature des sessions cockpit (≥ 32 caractères)
# Générer : openssl rand -hex 48
ADMIN_SESSION_SECRET=changez-moi-aussi-avec-32-caracteres-minimum
